{"file":"PremiumSubscriptionPanel-B3QXwiF0.js","mappings":";;;;;;;;;;;;;;;;;;;;AAsHA,UAAM,QAAQ;AAgBd,UAAM,mBAAmB,IAAI,KAAK;AAClC,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,cAAc,IAAI,KAAK;AAE7B,UAAM,kBAAkB,CAAC,UAAU;AACjC,UAAI,oBAAoB,QAAQ;AAAA,IAClC,CAAC;AAkBD;AAAA,MACE,MAAM,MAAM;AAAA,MACZ,CAAC,YAAY;AACX,YAAI,CAAC,QAAS,kBAAiB,QAAQ;AAAA,MACzC;AAAA,IAAA;AAGF;AAAA,MACE,MAAM,MAAM;AAAA,MACZ,CAAC,SAAS,eAAe;AACvB,YAAI,cAAc,CAAC,WAAW,CAAC,MAAM,uBAAuB,QAAQ;AAAA,MACtE;AAAA,IAAA;;;;;UAvKW,QAAA,iBAAe;;;;AAKLA,sBAAA,QAAA,WAAR,SAAI;;AAKF,gBAAAC,mBAAAC,MAAA,KAAA,GAAA,EAAA,OAAM,8BAAA,GAA6B,MAAA,OAAA,CAAA;AAEH,gBAAA,+CAAAC,eAAA,KAAK,KAAK,CAAA,eAAA;AAAA;;;UAIvC,QAAA,WAAS;;YAId,QAAA,cAAY;8FACR,QAAA,YAAY,CAAA,MAAA;AAAA;;;uJAGiBA,eAAAD,MAAA,oBAAA,EAAqB,KAAK,QAC/DC,eAAAD,MAAA,oBAAA,EAAqB,MAAM,2BACNC,eAAAD,MAAA,oBAAA,EAAqB,cAAc,mLAKhD,QAAA,aAAa,IAAA,cAAA,qBAGrB,QAAA,gBAAa,YAAA,mBAAA;;8JAOXC,eAAAD,MAAA,oBAAA,EAAqB,KAAK,SAAWC,eAAAD,MAAA,oBAAA,EAAqB,MAAM,gHAGhBC,eAAAD,MAAA,oBAAA,EAAqB,cAAc;;sBAKlEA,MAAA,gBAAA;AAAA,uEAAA,iBAAgB,QAAA,SAAA;AAAA,UAAE,OAAM;AAAA,QAAA;2BAAhD,CAWgB,GAAAE,QAAAC,UAAA,aAAA;;qFATTF,eAAAD,MAAA,oBAAA,EAAqB,WAAW;;gBAEhC,IAAE,UAAYA,MAAA,oBAAA,EAAqB,SAAS;AAAA,gBAC7C,OAAM;AAAA,gBACL,SAAD,MAAA;AAAA,gBAAA;AAAA,cAAA;iCAHF,CAMWI,IAAAF,QAAAC,UAAAE,cAAA;;;;;sCAFV,UAED;AAAA,oBAAA;AAAA;;;;;;;gBARFC,YASI,KAAA,EATD,OAAM,4CAAwC;AAAA,kDAC5CN,MAAA,oBAAA,EAAqB,WAAW,IAAG,KACtC,CAAA;AAAA,kBAAAM,YAMW,qBAAA;AAAA,oBALR,IAAE,UAAYN,MAAA,oBAAA,EAAqB,SAAS;AAAA,oBAC7C,OAAM;AAAA,oBACL,uBAAD,MAAA;AAAA,oBAAA,GAAW,CAAA,MAAA,CAAA;AAAA,kBAAA;qCACZ,MAED;AAAA,sCAFC,UAED;AAAA,oBAAA;;;;;;;;;YAGKA,MAAA,YAAA,GAAY;4EAA4CA,MAAA,YAAA,CAAY,CAAA,MAAA;AAAA;;;oLAKhE,QAAA,eAAe,IAAA,cAAA,MAGvBC,eAAA,QAAA,oDAAoDD,MAAA,oBAAA,EAAqB,KAAK,MAAMA,MAAA,oBAAA,EAAqB,MAAM,EAAA,0FAKvG,QAAA,eAAe,IAAA,cAAA,qBAGvB,QAAA,kBAAe,eAAA,0BAAA;;+BAOtB,CAuBWE,WAAA;YArBIF,MAAA,WAAA,GAAW;;;;;YAGXA,MAAA,WAAA,GAAW;6ZAQP,QAAA,aAAa,IAAA,cAAA,qBAGrB,QAAA,gBAAa,YAAA,uBAAA;;;;;;;;;;;;;;;","names":["_ssrRenderList","_ssrRenderComponent","_unref","_ssrInterpolate","_push","_parent","_","_scopeId","_createVNode"],"sources":["../../../../components/PremiumSubscriptionPanel.vue"],"sourcesContent":["<template>\n  <div>\n    <p v-if=\"featuresLoading\" class=\"mb-4 text-center text-sm text-sber-gray\">\n      Загрузка возможностей…\n    </p>\n    <div v-else class=\"mb-4 max-h-48 space-y-3 overflow-y-auto\">\n      <div\n        v-for=\"feat in features\"\n        :key=\"feat.key\"\n        class=\"flex items-center gap-3\"\n      >\n        <div class=\"flex h-6 w-6 items-center justify-center rounded-full bg-yellow-100\">\n          <Check class=\"h-3.5 w-3.5 text-yellow-600\" />\n        </div>\n        <span class=\"text-sm text-sber-black\">{{ feat.title }}</span>\n      </div>\n    </div>\n\n    <template v-if=\"isPremium\">\n      <p class=\"text-center text-sm font-semibold text-sber-green\">\n        Premium активен\n      </p>\n      <p v-if=\"expiresLabel\" class=\"mt-1 text-center text-xs text-sber-gray\">\n        Срок до {{ expiresLabel }}\n      </p>\n      <p class=\"mt-4 rounded-2xl bg-sber-gray-light px-4 py-3 text-xs leading-relaxed text-sber-gray\">\n        Подписка продлевается автоматически: {{ PREMIUM_SUBSCRIPTION.price }} ₽/\n        {{ PREMIUM_SUBSCRIPTION.period }}.\n        Следующее списание — {{ PREMIUM_SUBSCRIPTION.chargeSchedule }}.\n      </p>\n      <button\n        class=\"mt-4 w-full rounded-2xl border border-red-200 bg-red-50 py-3.5 text-sm font-semibold text-red-600 disabled:opacity-60\"\n        type=\"button\"\n        :disabled=\"cancelLoading\"\n        @click=\"cancelModal = true\"\n      >\n        {{ cancelLoading ? 'Отмена…' : 'Отменить подписку' }}\n      </button>\n    </template>\n\n    <template v-else>\n      <div class=\"mb-4 rounded-2xl border border-yellow-200/80 bg-yellow-50/60 px-4 py-3\">\n        <p class=\"text-sm font-semibold text-sber-black\">\n          {{ PREMIUM_SUBSCRIPTION.price }} ₽ / {{ PREMIUM_SUBSCRIPTION.period }}\n        </p>\n        <p class=\"mt-1 text-xs leading-relaxed text-sber-gray\">\n          Подписка с автоматическим продлением. Списания: {{ PREMIUM_SUBSCRIPTION.chargeSchedule }}.\n          Оплата через Robokassa.\n        </p>\n      </div>\n\n      <OtterCheckbox v-model=\"recurringConsent\" class=\"mb-4\">\n        <p class=\"text-sm leading-relaxed text-sber-gray\">\n          {{ PREMIUM_SUBSCRIPTION.consentText }}\n          <NuxtLink\n            :to=\"`/legal/${PREMIUM_SUBSCRIPTION.offerSlug}`\"\n            class=\"font-medium text-sber-green underline\"\n            @click.stop\n          >\n            оферты\n          </NuxtLink>\n        </p>\n      </OtterCheckbox>\n      <p v-if=\"consentError\" class=\"mb-3 ml-1 text-xs text-red-500\">{{ consentError }}</p>\n\n      <button\n        class=\"w-full rounded-2xl bg-gradient-to-r from-yellow-400 to-yellow-600 py-4 font-bold text-white disabled:opacity-60\"\n        type=\"button\"\n        :disabled=\"checkoutLoading\"\n        @click=\"handleCheckout\"\n      >\n        {{ checkoutLoading ? 'Открываем оплату…' : `Оплатить ${PREMIUM_SUBSCRIPTION.price} ₽/${PREMIUM_SUBSCRIPTION.period}` }}\n      </button>\n      <button\n        class=\"btn-secondary mt-2 w-full\"\n        type=\"button\"\n        :disabled=\"activateLoading\"\n        @click=\"$emit('activate')\"\n      >\n        {{ activateLoading ? 'Активация…' : 'Я оплатил — активировать' }}\n      </button>\n      <p class=\"mt-3 text-center text-xs text-sber-gray\">\n        После оплаты нажмите «Я оплатил — активировать», если Premium не включился автоматически.\n      </p>\n    </template>\n\n    <Teleport to=\"body\">\n      <Transition name=\"overlay\">\n        <div v-if=\"cancelModal\" class=\"overlay\" @click=\"cancelModal = false\" />\n      </Transition>\n      <Transition name=\"modal\">\n        <div v-if=\"cancelModal\" class=\"app-modal px-5 py-5\" @click.stop>\n          <h3 class=\"text-lg font-bold text-sber-black\">Отменить подписку?</h3>\n          <p class=\"mt-2 text-sm leading-relaxed text-sber-gray\">\n            Автоматические списания прекратятся. Доступ к Premium сохранится до конца оплаченного периода.\n          </p>\n          <button\n            class=\"mt-5 w-full rounded-2xl bg-red-500 py-4 font-semibold text-white disabled:opacity-60\"\n            type=\"button\"\n            :disabled=\"cancelLoading\"\n            @click=\"handleCancel\"\n          >\n            {{ cancelLoading ? 'Отмена…' : 'Да, отменить подписку' }}\n          </button>\n          <button class=\"btn-secondary mt-3 w-full\" type=\"button\" @click=\"cancelModal = false\">\n            Не отменять\n          </button>\n        </div>\n      </Transition>\n    </Teleport>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { Check } from 'lucide-vue-next'\nimport type { ApiPremiumFeature } from '~/types/mobile-api'\nimport { PREMIUM_SUBSCRIPTION } from '~/utils/site-info'\n\nconst props = defineProps<{\n  features: ApiPremiumFeature[]\n  featuresLoading?: boolean\n  isPremium: boolean\n  expiresLabel?: string\n  checkoutLoading?: boolean\n  activateLoading?: boolean\n  cancelLoading?: boolean\n}>()\n\nconst emit = defineEmits<{\n  checkout: [consent: { accepted: boolean; offerVersion: string; consentText: string }]\n  activate: []\n  cancel: []\n}>()\n\nconst recurringConsent = ref(false)\nconst consentError = ref('')\nconst cancelModal = ref(false)\n\nwatch(recurringConsent, (value) => {\n  if (value) consentError.value = ''\n})\n\nfunction handleCheckout() {\n  if (!recurringConsent.value) {\n    consentError.value = 'Подтвердите согласие на автоматические списания'\n    return\n  }\n  emit('checkout', {\n    accepted: true,\n    offerVersion: PREMIUM_SUBSCRIPTION.offerVersion,\n    consentText: PREMIUM_SUBSCRIPTION.consentText,\n  })\n}\n\nfunction handleCancel() {\n  emit('cancel')\n}\n\nwatch(\n  () => props.isPremium,\n  (premium) => {\n    if (!premium) recurringConsent.value = false\n  },\n)\n\nwatch(\n  () => props.cancelLoading,\n  (loading, wasLoading) => {\n    if (wasLoading && !loading && !props.isPremium) cancelModal.value = false\n  },\n)\n</script>\n"],"version":3}