{"file":"success-dzyyM74c.js","mappings":";;;;;;;;;;;;;;;;;;;;;AA+CkB,iBAAA;AAClB,UAAM,eAAe,gBAAA;AACrB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,QAAQ,IAAI,EAAE;AAEpB,UAAM,eAAe,SAAS,MAAM;AAClC,YAAM,QAAQ,aAAa;AAC3B,UAAI,CAAC,MAAO,QAAO;AACnB,YAAM,OAAO,IAAI,KAAK,KAAK;AAC3B,UAAI,OAAO,MAAM,KAAK,QAAA,CAAS,EAAG,QAAO;AACzC,aAAO,IAAI,KAAK,eAAe,SAAS;AAAA,QACtC,KAAK;AAAA,QACL,OAAO;AAAA,QACP,MAAM;AAAA,MAAA,CACP,EAAE,OAAO,IAAI;AAAA,IAChB,CAAC;AAED,UAAM,cAAc,SAAS,MAAM,aAAa,cAAc,QAAQ,SAAS,EAAE;;;AA/D1E,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,6CAAyC,MAAA,CAAA,CAAA,kYAAA;UAUvCC,MAAA,OAAA,GAAO;;MACF,WAAAA,MAAA,YAAA,EAAa,WAAS;;YAEtBA,MAAA,WAAA,GAAW;2CAAQA,MAAA,WAAA,CAAW,CAAA,SAAA;AAAA;;;YAC9BA,MAAA,YAAA,GAAY;4CAASA,MAAA,YAAA,CAAY,CAAA,SAAA;AAAA;;;;iBAEjCA,MAAA,KAAA,GAAK;qEAAuCA,MAAA,KAAA,CAAK,CAAA,MAAA;AAAA;;;iHAShDA,MAAA,OAAA,CAAO,IAAA,cAAA,qBAGfA,MAAA,OAAA,IAAO,gBAAA,iBAAA;;QAEF,IAAG;AAAA,QAA8B,OAAM;AAAA,MAAA;yBAAjD,CAEW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAF+E,wBAE1F;AAAA,YAAA;AAAA;;;;;QACU,IAAG;AAAA,QAAO,OAAM;AAAA,MAAA;yBAA1B,CAEW,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAF2D,cAEtE;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent"],"sources":["../../../../pages/premium/success.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-dvh bg-sber-gray-light px-4 py-10\">\n    <div class=\"mx-auto max-w-md rounded-3xl bg-white p-6 shadow-card text-center\">\n      <div class=\"mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-sber-green-light text-3xl\">\n        ✓\n      </div>\n      <h1 class=\"text-2xl font-bold text-sber-black\">Оплата прошла</h1>\n      <p class=\"mt-3 text-sm leading-relaxed text-sber-gray\">\n        Robokassa подтвердила платёж. Мы обновляем статус Premium…\n      </p>\n\n      <p v-if=\"loading\" class=\"mt-6 text-sm text-sber-gray\">Проверяем подписку…</p>\n      <p v-else-if=\"premiumStore.isPremium\" class=\"mt-6 text-sm font-semibold text-sber-green\">\n        Premium активен\n        <span v-if=\"tariffTitle\"> · {{ tariffTitle }}</span>\n        <span v-if=\"expiresLabel\"> до {{ expiresLabel }}</span>\n      </p>\n      <p v-else-if=\"error\" class=\"mt-6 text-sm text-red-500\">{{ error }}</p>\n      <p v-else class=\"mt-6 text-sm text-sber-gray\">\n        Статус ещё обновляется. Нажмите «Обновить» через несколько секунд.\n      </p>\n\n      <div class=\"mt-8 space-y-3\">\n        <button\n          class=\"btn-primary w-full\"\n          type=\"button\"\n          :disabled=\"loading\"\n          @click=\"refresh\"\n        >\n          {{ loading ? 'Обновление…' : 'Обновить статус' }}\n        </button>\n        <NuxtLink to=\"/app/settings?openPremium=1\" class=\"btn-secondary block w-full text-center\">\n          К настройкам Premium\n        </NuxtLink>\n        <NuxtLink to=\"/app\" class=\"block text-sm font-medium text-sber-green\">\n          На главную\n        </NuxtLink>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { getApiErrorMessage } from '~/utils/api'\n\ndefinePageMeta({ layout: false })\n\nconst authStore = useAuthStore()\nconst premiumStore = usePremiumStore()\nconst loading = ref(false)\nconst error = ref('')\n\nconst expiresLabel = computed(() => {\n  const value = premiumStore.expiresAt\n  if (!value) return ''\n  const date = new Date(value)\n  if (Number.isNaN(date.getTime())) return ''\n  return new Intl.DateTimeFormat('ru-RU', {\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric',\n  }).format(date)\n})\n\nconst tariffTitle = computed(() => premiumStore.subscription?.tariff?.title || '')\n\nasync function refresh() {\n  if (!authStore.isLoggedIn) {\n    error.value = 'Войдите в аккаунт, чтобы проверить Premium'\n    return\n  }\n  loading.value = true\n  error.value = ''\n  try {\n    await premiumStore.fetchSubscription()\n  }\n  catch (err) {\n    error.value = getApiErrorMessage(err, 'Не удалось обновить статус')\n  }\n  finally {\n    loading.value = false\n  }\n}\n\nonMounted(() => {\n  void refresh()\n})\n</script>\n"],"version":3}